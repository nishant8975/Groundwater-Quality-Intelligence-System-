# ==============================================================================
# Groundwater Quality Intelligence — Production Environment Configuration Templates
# DO NOT COMMIT REAL PASSWORDS OR API KEYS TO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL BACKEND DEVELOPMENT (.env at root)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=groundwater_quality
DB_USER=postgres
DB_PASSWORD=YOUR_LOCAL_PASSWORD
DB_SSL=false
CORS_ORIGIN=http://localhost:5173
PORT=3000

# ------------------------------------------------------------------------------
# 2. RENDER BACKEND PRODUCTION (Environment Variables in Render Dashboard)
# ------------------------------------------------------------------------------
# DB_HOST=db.your-supabase-id.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=YOUR_SUPABASE_PASSWORD
# DB_SSL=true
# CORS_ORIGIN=https://your-vercel-domain.vercel.app
# Note: Render automatically provides the PORT environment variable.

# ------------------------------------------------------------------------------
# 3. VERCEL FRONTEND PRODUCTION (Environment Variables in Vercel Dashboard)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=https://your-render-service.onrender.com/api
# VITE_CARTO_API_KEY=YOUR_CARTO_API_KEY
